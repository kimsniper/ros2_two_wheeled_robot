<?xml version="1.0"?>

<robot name="two_wheel_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Include Gazebo Parameters -->
    <xacro:include filename="$(find robot_description)/urdf/two_wheel_robot_gazebo.urdf.xacro" />

    <!-- Include ros2_control Plugins -->
    <xacro:include filename="$(find robot_description)/urdf/two_wheel_robot_ros2_control.urdf.xacro" />

    <!-- Links -->
    
    <link name="base_footprint"/>

    <link name="base_link">

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="5.0"/>

            <inertia
                ixx="0.2"
                ixy="0.0"
                ixz="0.0"
                iyy="0.2"
                iyz="0.0"
                izz="0.2"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.2 0.4 0.2"/>
            </geometry>

            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.1"/>
            <geometry>
                <box size="0.2 0.4 0.2"/>
            </geometry>
        </collision>

    </link>

    <link name="left_wheel">
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.3"/>
            <inertia
                ixx="0.0005" ixy="0.0" ixz="0.0"
                iyy="0.0005" iyz="0.0"
                izz="0.0005"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
        </collision>
    </link>

    <link name="right_wheel">
        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.3"/>
            <inertia
                ixx="0.0005" ixy="0.0" ixz="0.0"
                iyy="0.0005" iyz="0.0"
                izz="0.0005"/>
        </inertial>

        <visual>
            <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="1.5707 0 0"/>
            <geometry>
                <cylinder radius="0.05" length="0.03"/>
            </geometry>
        </collision>
    </link>

    <!-- Joints -->

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel"/>
        <origin xyz="0 0.215 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel"/>
        <origin xyz="0 -0.215 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <!-- IMU -->
    <link name="imu_link">

        <inertial>
            <origin xyz="0 0 0"/>
            <mass value="0.01"/>

            <inertia
                ixx="0.00001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.00001"
                iyz="0.0"
                izz="0.00001"/>
        </inertial>

    </link>

    <joint name="imu_joint" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="0 0 0"/>
    </joint>

</robot>